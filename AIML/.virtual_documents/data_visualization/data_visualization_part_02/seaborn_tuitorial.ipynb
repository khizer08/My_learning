# Relational plots

# scatter plot
sns.get_dataset_names()
tips = sns.load_dataset("tips")
print(tips.head())

sns.scatterplot(
    data=tips,
    x="total_bill",
    y="tip",
    hue="time"
)
plt.show()

# line plot
flights = sns.load_dataset("flights")

sns.lineplot(
    data=flights,
    x="year",
    y="passengers"
)
plt.show()


# Categorical plots

tips = sns.load_dataset("tips")

# Bar plot
sns.barplot(
    data=tips,
    x="day",
    y="total_bill",
    hue="sex"
)
plt.show()

# Box plot
sns.boxplot(
    data=tips,
    x="day",
    y="total_bill"
)
plt.show()


# Distribution plots

# histogram
penguins = sns.load_dataset("penguins")

sns.histplot(
    data=penguins,
    x="body_mass_g",
    bins=30
)

print(penguins.head())
plt.show()


# Matrix plots

# Heatmap
flights = sns.load_dataset("flights")
flights_pivot = flights.pivot(index="month", columns="year", values="passengers")
print(flights_pivot)

sns.heatmap(
    flights_pivot,
    cmap="coolwarm", 
    annot=True, #to show numbers in individual cells
    fmt="d" #for integer formatting
)
plt.title("Heatmap for Passengers")
plt.tight_layout()
plt.show()


# Recommended approach
tips = sns.load_dataset("tips")

fig, ax = plt.subplots()

sns.lineplot(
    data=tips,
    x="day",
    y="total_bill",
    hue="sex",
    marker="o",
    errorbar=None, # "ci=None" is deprecated so we are using "errorbar=None"
    ax=ax
)

ax.set_title("Average Total Bill by Day and Sex")
ax.set_xlabel("Day of Week")
ax.set_ylabel("Total Bill ($)")

ax.legend(title="Sex")
plt.tight_layout()

plt.show()




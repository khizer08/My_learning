import pandas as pd


df=pd.read_csv("raw_data.csv")


# Transformation / Feature Engineering
df2 = df.copy()

# apply a fnx to a row or col
df2["tax"]=df2["income"].apply(lambda x: "20%" if x>=60_000 else "10%")

# map values to another
new_gender_vals={"Male":"M","Female":"F","Unknown":"UNK"}
df2["gender"]=df2["gender"].map(new_gender_vals)

# assign some new values
df2=df2.assign(new_income=df2["income"]*1.1)

# replace specific values
df2["country"]=df2["country"].replace("USA","US")


df2


# Transformation - Sorting

# Renaming
df2.columns=["Id","Name","Age","Country","Gender","Income","Tax","New_Income"]
df2=df2.rename(columns={"Income":"Salary"})
# df2=df2.rename(index={1:"first"})

# # Sorting - values & index
df2.sort_values("Salary")                      # sort values in ascending
df2.sort_values("Salary",ascending=False)      # sort values in descending
df2["Age"]=df2["Age"].fillna(50)
sorted_df2=df2.sort_values(["Salary","Age"])   # sorts for salary, if salary is same then sorts for age  

sorted_df2.sort_index()                        # sorts the index so back to normal form

# Reset Index
sorted_df2.reset_index()                       # preserves the origiinal index by making the new column "index" and introduce new index for table
sorted_df2.reset_index(drop=True)              # to drop original index vals

# # Ranking
df2["Ranking"] = df2["Salary"].rank(ascending=False, method="dense")
# df2["Ranking"] = df2["Salary"].rank(ascending=False, method="min")
# df2["Ranking"] = df2["Salary"].rank(ascending=False, method="max")

# # Reorder
df2[["Id", "Name", "Age", "Salary", "Ranking","Gender", "Country","Tax","New_Income"]]


df2




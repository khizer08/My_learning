sns.boxplot(ax=axes[0,1], data=loan_data, x="Loan_Approved", y="Credit_Score")
sns.boxplot(ax=axes[1,0], data=loan_data, x="Loan_Approved", y="DTI_Ratio")
sns.boxplot(ax=axes[1,1], data=loan_data, x="Loan_Approved", y="Savings")
